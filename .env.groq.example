# Copy these settings into .env, then add your Groq key locally. Do not commit .env.
MODEL_MODE=live
MODEL_PROVIDER=groq
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_ID=openai/gpt-oss-120b
MODEL_API_KEY=
MODEL_FORMAT=auto
MODEL_TIMEOUT_MS=45000
RUN_TIMEOUT_MS=300000
MAX_MODEL_CALLS=80
MAX_ACTIONS=65
ACTION_TIMEOUT_MS=6000
LEASE_MS=15000
MAX_ATTEMPTS=2
MODEL_QUOTA_GROUP=default
# Optional request spacing; choose a floor appropriate to your account's RPM limit.
MODEL_MIN_INTERVAL_MS=2000
MODEL_MAX_QUOTA_WAIT_MS=60000
RETENTION_DAYS=0
RETENTION_KEEP_RUNS=20
ARCHIVE_RETENTION_DAYS=0
ARCHIVE_DIR=./data/archives
ALLOWED_TARGET_ORIGINS=http://127.0.0.1:4100,http://127.0.0.1:4101
DATABASE_PATH=./data/proofpack.sqlite
ARTIFACT_DIR=./artifacts
