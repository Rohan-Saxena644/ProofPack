{
  "name": "proofpack",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "worker": "tsx src/worker/main.ts",
    "demo:working": "tsx src/launchdesk/server.ts --port=4100 --mode=working",
    "demo:broken": "tsx src/launchdesk/server.ts --port=4101 --mode=broken",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "format": "prettier --write src scripts tests docs *.json *.mjs *.ts README.md",
    "dev:all": "concurrently -k -n dashboard,worker,working,broken \"npm:dev\" \"npm:worker\" \"npm:demo:working\" \"npm:demo:broken\"",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:all": "concurrently -k -n dashboard,worker,working,broken \"npm:start\" \"npm:worker\" \"npm:demo:working\" \"npm:demo:broken\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/unit.test.ts tests/improvements.test.ts",
    "retention": "tsx scripts/retention.ts",
    "test:e2e": "tsx scripts/verify.ts",
    "test:live": "tsx scripts/verify-live.ts",
    "test:dashboard": "tsx scripts/smoke-dashboard.ts",
    "test:improvements": "tsx scripts/verify-improvements.ts",
    "browsers": "playwright install chromium",
    "model:check": "tsx scripts/check-model.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
