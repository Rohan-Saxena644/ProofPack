# Copy to .env. Fixture mode never makes model requests.
MODEL_MODE=fixture
MODEL_PROVIDER=openrouter
MODEL_BASE_URL=https://openrouter.ai/api/v1
# Run npm run model:check to inspect current availability and structured-output support.
MODEL_ID=google/gemma-3-27b-it
MODEL_API_KEY=
# Groq alternative: MODEL_PROVIDER=groq, MODEL_BASE_URL=https://api.groq.com/openai/v1,
# MODEL_ID=openai/gpt-oss-120b, MODEL_API_KEY=<your Groq key>.
# auto probes hosted catalogs and uses documented Groq strict-output support.
# For local endpoints set json_schema, json_object, or none.
MODEL_FORMAT=auto
MODEL_TIMEOUT_MS=30000
MAX_MODEL_CALLS=80
MAX_ACTIONS=65
RUN_TIMEOUT_MS=180000
ACTION_TIMEOUT_MS=6000
LEASE_MS=15000
MAX_ATTEMPTS=2
ALLOWED_TARGET_ORIGINS=http://127.0.0.1:4100,http://127.0.0.1:4101
DATABASE_PATH=./data/proofpack.sqlite
ARTIFACT_DIR=./artifacts
# Each LaunchDesk instance gets an independent database by default.
